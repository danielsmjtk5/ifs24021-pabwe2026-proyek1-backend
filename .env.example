# Lingkungan: development | production | test
NODE_ENV=development
PORT=3000

# Lokasi file SQLite. Pada hosting, arahkan ke lokasi yang tidak terhapus saat redeploy.
DB_PATH=./data/asramacare.db

# Rahasia penandatanganan JWT. WAJIB diganti dengan string acak panjang (min. 32 karakter).
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-minimal-32-karakter
JWT_EXPIRES_IN=1d

# URL front-end yang di-deploy (tanpa / di akhir). Dipakai sebagai default CORS_ORIGIN
# dan menentukan cookie Secure saat produksi (scripts/start.js).
FRONTEND_URL=http://localhost:5173

# Origin front-end yang diizinkan CORS (pisahkan dengan koma). Contoh produksi:
# CORS_ORIGIN=https://ifs24021-pabwe2026-proyek1.s1if.cloud
CORS_ORIGIN=http://localhost:5173

# Cookie sesi. Front-end dan back-end di subdomain yang sama (mis. *.s1if.cloud) cukup "lax".
# Jika domainnya benar-benar berbeda, gunakan COOKIE_SAMESITE=none dan COOKIE_SECURE=true (HTTPS).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Akun admin awal yang dibuat oleh seed. Ganti di produksi.
ADMIN_NAME=Admin Asrama
ADMIN_EMAIL=admin@asramacare.test
ADMIN_PASSWORD=Admin12345

# Isi true untuk membuat akun penghuni dan laporan demo saat seed.
SEED_DEMO=true
# Password akun penghuni demo (budi/sari). Default: Penghuni123
# SEED_DEMO_PASSWORD=
