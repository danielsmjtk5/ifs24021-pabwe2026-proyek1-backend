# Lingkungan: development | production | test
NODE_ENV=development
PORT=3000

# Database (SQLite/libSQL).
# - Lokal: file SQLite, contoh file:./data/asramacare.db (default bila kosong).
# - Vercel: database Turso, contoh libsql://asramacare-<username>.turso.io
#   DATABASE_AUTH_TOKEN diisi token dari `turso db tokens create <nama-db>`.
DATABASE_URL=file:./data/asramacare.db
DATABASE_AUTH_TOKEN=

# Rahasia penandatanganan JWT. WAJIB diganti dengan string acak panjang (min. 32 karakter).
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-minimal-32-karakter
JWT_EXPIRES_IN=1d

# URL front-end yang di-deploy (tanpa / di akhir). Dipakai sebagai CORS_ORIGIN bila CORS_ORIGIN kosong.
FRONTEND_URL=http://localhost:5173

# Origin front-end yang diizinkan CORS (pisahkan dengan koma). Contoh produksi:
# CORS_ORIGIN=https://ifs24021-pabwe2026-proyek1.s1if.cloud
CORS_ORIGIN=http://localhost:5173

# Cookie sesi.
# - Lokal (front-end dan back-end di localhost): lax + false.
# - Vercel (back-end *.vercel.app, front-end *.s1if.cloud = beda situs):
#   COOKIE_SAMESITE=none, COOKIE_SECURE=true, COOKIE_PARTITIONED=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_PARTITIONED=false

# Akun admin awal yang dibuat oleh seed. Ganti di produksi.
ADMIN_NAME=Admin Asrama
ADMIN_EMAIL=admin@asramacare.test
ADMIN_PASSWORD=Admin12345

# Isi true untuk membuat akun penghuni dan laporan demo saat seed.
SEED_DEMO=true
# Password akun penghuni demo (budi/sari). Default: Penghuni123
# SEED_DEMO_PASSWORD=
